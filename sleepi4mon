def to_history(values):
    return "{}".format(values)[1:-1]
    

def parse_environment(path):
    parser = configparser.ConfigParser()
    parser.read_dict({'DEFAULT': {
        'I2C_ADDRESS': DEFAULT_I2C_ADDRESS,
        'I2C_BUS': DEFAULT_I2C_BUS,
    }})
   
    try: 
        with open(path, 'r') as file:
            string = file.read()
    except IOError as e:
        print("Cannot access {}.".format(path))
        exit(e)
    
    parser.read_string('[env]' + string)
    env = parser['env']
    
    return env 


def read_configure(path):
    conf = {}
    
    try: 
        with open(path, 'r') as file:
            conf = yaml.safe_load(file)
    except IOError as e:
        print("Cannot access {}.".format(path))
        exit(e)
    
    return conf
    

def main(args):
    monitor_type = {
        'extin1': Sleepi4Extin1Monitor,
        'extin2': Sleepi4Extin2Monitor,
        'pushsw': Sleepi4PushswMonitor,
        'voltage1': Sleepi4Voltage1Monitor,
        'voltage2': Sleepi4Voltage2Monitor,
        'current': Sleepi4CurrentMonitor,
        'power': Sleepi4PowerMonitor,
        'energy': Sleepi4EnergyMonitor
    }
    event_type = {
        'any': EventAny,
        'none': EventNone,
        'over': EventOver,
        'under': EventUnder
    }

    if '-D' in args:
        loop = True
    else:
        loop = False
   
    if '-c' in args: 
        configs = read_configure(args[args.index('-c') + 1])
    else:
        configs = read_configure(CONFIG_FILE)
    
    env = parse_environment(ENV_FILE)
    bus = int(env['I2C_BUS'])
    addr = int(env['I2C_ADDRESS'], 16)
    sleepi4 = sleepi.Sleepi4(bus, addr)
    monitors = []
    
    interval = configs['common']['interval']
    for key in monitor_type.keys():
        if not key in configs:
            continue
        if not configs[key]['commands']:
            continue
        if not 'history_size' in configs[key]:
            histsize = 1
        else:
            histsize = configs[key]['history_size']
        mon = monitor_type[key](sleepi4, histsize)
        for cmd in configs[key]['commands']:
            mon.add_event(event_type[cmd['condition']](cmd))
        monitors.append(mon)
    
    while True:
        for mon in monitors:
            mon.update_value()
            g_env.update(mon.get_history())
            for ev in mon.events:
                if ev.is_triggered(mon):
                    ev.do_action(g_env)
        if loop:
            time.sleep(interval)
        else:
            break


if __name__ == '__main__':
    g_env = os.environ.copy()
    
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(0)

